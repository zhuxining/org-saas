{
  "name": "org-sass",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7",
      "@types/node": "^25",
      "react": "^19",
      "react-dom": "^19",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "vite": "npm:@voidzero-dev/vite-plus-core",
      "@vitejs/plugin-react": "^6.0.1",
      "tailwindcss": "^4.2.4",
      "@tailwindcss/vite": "^4.2.4",
      "tailwind-merge": "^3.5.0",
      "dotenv": "^17.4.2",
      "zod": "^4.4.2",
      "lucide-react": "^1.14.0",
      "pino": "^10.3.1",
      "@orpc/server": "^1.14.1",
      "@orpc/client": "^1.14.1",
      "@orpc/openapi": "^1.14.1",
      "@orpc/zod": "^1.14.1",
      "@orpc/tanstack-query": "^1.14.1",
      "@orpc/experimental-pino": "^1.14.1",
      "@orpc/experimental-ratelimit": "^1.14.1",
      "better-auth": "^1.6.9",
      "@tanstack/react-router": "^1.169.1",
      "@tanstack/react-start": "^1.167.62",
      "@tanstack/router-plugin": "^1.167.32",
      "@tanstack/react-query": "^5.100.9",
      "@tanstack/react-form": "^1.29.1",
      "@tanstack/react-table": "^8.21.3",
      "@tanstack/react-router-with-query": "^1.130.17",
      "@tanstack/react-router-devtools": "^1.166.13",
      "@tanstack/react-query-devtools": "^5.100.9",
      "@tanstack/react-form-devtools": "^0.2.22",
      "@tanstack/react-devtools": "^0.10.2",
      "@tanstack/devtools-vite": "^0.6.0",
      "react-resizable-panels": "^4.11.0",
      "shadcn": "^4.6.0",
      "@base-ui/react": "^1.4.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-orm": "^0.45.2",
      "drizzle-kit": "^0.31.10",
      "vite-plus": "^0.2.6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @org-sass/db db:push",
    "db:studio": "turbo -F @org-sass/db db:studio",
    "db:generate": "turbo -F @org-sass/db db:generate",
    "db:migrate": "turbo -F @org-sass/db db:migrate",
    "check": "biome check --write --unsafe",
    "check-types": "turbo check-types",
    "clean": "turbo clean && git clean -xdf node_modules .turbo .dist .output .tanstack .wrangler"
  },
  "dependencies": {
    "@org-sass/env": "workspace:*"
  },
  "devDependencies": {
    "@org-sass/config": "workspace:*",
    "turbo": "^2.10.7",
    "vite": "^0.2.6",
    "vite-plus": "^0.2.6"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
