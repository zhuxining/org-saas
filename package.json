{
  "name": "org-sass",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/node": "^26.1.2",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "vite": "npm:@voidzero-dev/vite-plus-core",
      "@vitejs/plugin-react": "^6.0.5",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "tailwind-merge": "^3.6.0",
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "lucide-react": "^1.28.0",
      "pino": "^10.3.1",
      "@orpc/server": "^1.14.13",
      "@orpc/client": "^1.14.13",
      "@orpc/openapi": "^1.14.13",
      "@orpc/zod": "^1.14.13",
      "@orpc/tanstack-query": "^1.14.13",
      "@orpc/experimental-pino": "^1.14.13",
      "@orpc/experimental-ratelimit": "^1.14.13",
      "better-auth": "^1.6.25",
      "@tanstack/react-router": "^1.170.18",
      "@tanstack/react-start": "^1.168.33",
      "@tanstack/router-plugin": "^1.168.23",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-form": "^1.33.2",
      "@tanstack/react-table": "^8.21.3",
      "@tanstack/react-router-with-query": "^1.130.17",
      "@tanstack/react-router-devtools": "^1.167.0",
      "@tanstack/react-query-devtools": "^5.101.4",
      "@tanstack/react-form-devtools": "^0.2.31",
      "@tanstack/react-devtools": "^0.10.9",
      "@tanstack/devtools-vite": "^0.8.3",
      "vite-plus": "^0.2.6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter web --filter fumadocs dev",
    "dev:web": "bun run --filter web dev",
    "dev:fumadocs": "bun run --filter fumadocs dev",
    "build": "bun run --parallel --filter web --filter fumadocs build",
    "db:push": "bun run --filter @org-sass/db db:push",
    "db:studio": "bun run --filter @org-sass/db db:studio",
    "db:generate": "bun run --filter @org-sass/db db:generate",
    "db:migrate": "bun run --filter @org-sass/db db:migrate",
    "check": "vp check",
    "clean": "bun run --workspaces --if-present clean && git clean -xdf node_modules .dist .output .tanstack .wrangler"
  },
  "dependencies": {
    "@org-sass/env": "workspace:*"
  },
  "devDependencies": {
    "@org-sass/config": "workspace:*",
    "taze": "^19.16.0",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
