{
  "name": "org-saas",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/node": "^26.6.4",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "vite": "npm:@voidzero-dev/vite-plus-core",
      "@vitejs/plugin-react": "^6.1.2",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "tailwind-merge": "^3.7.0",
      "dotenv": "^18.0.6",
      "zod": "^4.6.5",
      "lucide-react": "^1.53.0",
      "pino": "^10.4.0",
      "@orpc/server": "^2.0.0-beta.42",
      "@orpc/client": "^2.0.0-beta.42",
      "@orpc/openapi": "^2.0.0-beta.42",
      "@orpc/zod": "^2.0.0-beta.42",
      "@orpc/tanstack-query": "^2.0.0-beta.42",
      "@orpc/pino": "^2.0.0-beta.42",
      "@orpc/ratelimit": "^2.0.0-beta.42",
      "better-auth": "^1.7.7",
      "@tanstack/react-router": "^1.170.41",
      "@tanstack/react-start": "^1.168.60",
      "@tanstack/router-plugin": "^1.168.42",
      "@tanstack/react-query": "^5.104.1",
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-table": "^9.2.8",
      "@tanstack/react-router-with-query": "^1.130.17",
      "@tanstack/react-router-devtools": "^1.167.2",
      "@tanstack/react-query-devtools": "^5.104.1",
      "@tanstack/react-form-devtools": "^0.2.34",
      "@tanstack/react-devtools": "^0.10.13",
      "@tanstack/devtools-vite": "^0.8.5",
      "vite-plus": "^1.1.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter web --filter fumadocs dev",
    "dev:web": "vp run --filter web dev",
    "dev:fumadocs": "vp run --filter fumadocs dev",
    "build": "vp run --parallel --filter web --filter fumadocs build",
    "db:push": "vp run --filter @org-saas/db db:push",
    "db:studio": "vp run --filter @org-saas/db db:studio",
    "db:generate": "vp run --filter @org-saas/db db:generate",
    "db:migrate": "vp run --filter @org-saas/db db:migrate",
    "check": "vp check --fix",
    "clean": "vp run --workspaces --if-present clean && git clean -xdf node_modules .dist .output .tanstack .wrangler"
  },
  "dependencies": {
    "@org-saas/env": "workspace:*"
  },
  "devDependencies": {
    "@org-saas/config": "workspace:*",
    "@shadcn/lint": "^0.2.0",
    "taze": "^21.3.0",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
