{
  "name": "org-saas",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@types/node": "^26.6.5",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "vite": "npm:@voidzero-dev/vite-plus-core@^1.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "oxc-transform-react": "^0.155.0",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "tailwind-merge": "^3.7.0",
      "dotenv": "^18.0.8",
      "zod": "^4.6.7",
      "lucide-react": "^1.59.0",
      "pino": "^10.4.0",
      "fumadocs-core": "^16.17.7",
      "fumadocs-mdx": "^15.4.8",
      "fumadocs-ui": "^16.17.7",
      "@base-ui/react": "^1.9.0",
      "@shadcn/react": "^0.3.1",
      "@types/mdx": "^2.0.14",
      "@orpc/server": "2.0.0-beta.44",
      "@orpc/contract": "2.0.0-beta.44",
      "@orpc/client": "2.0.0-beta.44",
      "@orpc/openapi": "2.0.0-beta.44",
      "@orpc/json-schema": "2.0.0-beta.44",
      "@orpc/zod": "2.0.0-beta.44",
      "@orpc/tanstack-query": "2.0.0-beta.44",
      "@orpc/pino": "2.0.0-beta.44",
      "@orpc/ratelimit": "2.0.0-beta.44",
      "better-auth": "^1.7.11",
      "@better-auth/core": "1.7.11",
      "@tanstack/react-router": "^1.170.45",
      "@tanstack/react-start": "^1.169.3",
      "@tanstack/router-plugin": "^1.168.47",
      "@tanstack/react-query": "^5.104.5",
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-table": "^9.3.1",
      "@tanstack/react-router-with-query": "^1.130.17",
      "@tanstack/react-router-devtools": "^1.167.2",
      "@tanstack/react-query-devtools": "^5.104.5",
      "@tanstack/react-form-devtools": "^0.2.34",
      "@tanstack/react-devtools": "^0.10.13",
      "@tanstack/devtools-vite": "^0.8.5",
      "vite-plus": "^1.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vp run --parallel --filter web --filter fumadocs dev",
    "dev:web": "vp run --filter web dev",
    "dev:fumadocs": "vp run --filter fumadocs dev",
    "build": "vp run --parallel --filter web --filter fumadocs build",
    "db:push": "vp run --filter @org-saas/db db:push",
    "db:studio": "vp run --filter @org-saas/db db:studio",
    "db:generate": "vp run --filter @org-saas/db db:generate",
    "db:migrate": "vp run --filter @org-saas/db db:migrate",
    "audit:prune": "vp run --filter @org-saas/db audit:prune",
    "check": "vp check --fix",
    "test:e2e": "vp run --filter @org-saas/tests test:e2e",
    "clean": "git clean -xdf -- ':(glob)**/node_modules/**' ':(glob)**/.dist/**' ':(glob)**/.output/**' ':(glob)**/.tanstack/**' ':(glob)**/.wrangler/**'"
  },
  "dependencies": {
    "@org-saas/env": "workspace:*"
  },
  "devDependencies": {
    "@org-saas/config": "workspace:*",
    "@shadcn/lint": "^0.2.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
